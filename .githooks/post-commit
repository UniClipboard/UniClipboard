#!/bin/sh
set -eu

pin=$(cat .golangci-lint-version)
version=${pin#v}
lint=golangci-lint

if ! "$lint" --version 2>/dev/null | grep -Fq "version $version "; then
    cache="$PWD/.cache/tools/golangci-lint/$pin"
    lint="$cache/golangci-lint$(go env GOEXE)"
    if [ ! -x "$lint" ]; then
        printf 'post-commit: installing golangci-lint %s\n' "$pin"
        mkdir -p "$cache"
        GOBIN="$cache" go install "github.com/golangci/golangci-lint/v2/cmd/golangci-lint@$pin"
    fi
fi

printf 'post-commit: running golangci-lint %s\n' "$pin"
"$lint" run --allow-serial-runners ./...
"$lint" fmt --diff --diff-colored=false
