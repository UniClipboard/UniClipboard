{
  "expo": {
    "name": "UniClipboard UI Shell",
    "slug": "uniclipboard-ui-shell",
    "scheme": "uniclipboard-ui-shell",
    "version": "0.0.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.uniclipboard.shell",
      "entitlements": {
        "com.apple.security.application-groups": ["group.app.uniclipboard.shell.incoming-share"]
      },
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSCameraUsageDescription": "Take a photo for clipboard history or scan a pairing code.",
        "NSPhotoLibraryAddUsageDescription": "Save an image from clipboard history to Photos.",
        "UIApplicationSceneManifest": {
          "UIApplicationSupportsMultipleScenes": false,
          "UISceneConfigurations": {
            "UIWindowSceneSessionRoleApplication": [
              {
                "UISceneConfigurationName": "Default Configuration",
                "UISceneDelegateClassName": "$(PRODUCT_MODULE_NAME).SceneDelegate"
              }
            ]
          }
        }
      }
    },
    "android": {
      "package": "app.uniclipboard.shell",
      "softwareKeyboardLayoutMode": "pan",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundImage": "./assets/adaptive-icon-bg.png",
        "monochromeImage": "./assets/adaptive-icon-mono.png"
      }
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Take a photo for clipboard history or scan a pairing code.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      "./plugins/withAndroidIncomingShare.js",
      "./plugins/withAndroidSplashScreen.js",
      "@bacons/apple-targets",
      "./plugins/withXcode27SceneLifecycle.js",
      "./plugins/withXcode27DeploymentTargets.js",
      [
        "./plugins/withAppDisplayName.js",
        {
          "displayName": "Unic"
        }
      ]
    ]
  }
}
