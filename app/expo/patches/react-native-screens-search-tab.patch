+- (BOOL)shouldUseTabsAPIForControllers:(nonnull NSArray<RNSTabsScreenViewController *> *)controllers
+{
+#if !TARGET_OS_TV && !TARGET_OS_VISION
+  if (@available(iOS 26.0, *)) {
+    for (RNSTabsScreenViewController *controller in controllers) {
+      if (controller.tabScreenComponentView.systemItem == RNSTabsScreenSystemItemSearch) {
+        return YES;
+      }
+    }
+  }
+#endif // !TARGET_OS_TV && !TARGET_OS_VISION
+  return NO;
+}
+
+- (void)updateTabsWithControllers:(nonnull NSArray<RNSTabsScreenViewController *> *)controllers
+    API_AVAILABLE(ios(18.0))
+{
+  NSMutableArray<UITab *> *nextTabs = [NSMutableArray arrayWithCapacity:controllers.count];
+  for (RNSTabsScreenViewController *controller in controllers) {
+    BOOL isSearch = controller.tabScreenComponentView.systemItem == RNSTabsScreenSystemItemSearch;
+    UITab *tab = [self existingTabForController:controller isSearch:isSearch];
+    if (tab == nil) {
+      tab = [self createTabForController:controller isSearch:isSearch];
+    }
+    [nextTabs addObject:tab];
+  }
+
+  BOOL animated = _usesTabsAPI && self.tabs.count != 0;
+  _usesTabsAPI = YES;
+  [self setTabs:nextTabs animated:animated];
+  [self updateProminentSearchTab];
+  [self syncTabsWithTabBarItems];
+}
+
+/// On iOS 27 a `UISearchTab` is detached from the tab bar only when it is the prominent tab
+/// (or when it activates search automatically, which our search tab does not).
+- (void)updateProminentSearchTab API_AVAILABLE(ios(18.0))
+{
+#if RNS_IPHONE_OS_VERSION_AVAILABLE(27_0) && !TARGET_OS_TV
+  if (@available(iOS 27.0, *)) {
+    NSString *searchTabIdentifier = nil;
+    for (UITab *tab in self.tabs) {
+      if ([tab isKindOfClass:UISearchTab.class]) {
+        searchTabIdentifier = tab.identifier;
+        break;
+      }
+    }
+    if (self.prominentTabIdentifier != searchTabIdentifier &&
+        ![self.prominentTabIdentifier isEqualToString:searchTabIdentifier]) {
+      [self setProminentTabIdentifier:searchTabIdentifier animated:NO];
+    }
+  }
+#endif // RNS_IPHONE_OS_VERSION_AVAILABLE(27_0) && !TARGET_OS_TV
+}
+
+- (nullable UITab *)existingTabForController:(nonnull RNSTabsScreenViewController *)controller
+                                    isSearch:(BOOL)isSearch API_AVAILABLE(ios(18.0))
+{
+  for (UITab *tab in self.tabs) {
+    if (tab.userInfo == controller && [tab isKindOfClass:UISearchTab.class] == isSearch) {
+      return tab;
+    }
+  }
+  return nil;
+}
+
+- (nonnull UITab *)createTabForController:(nonnull RNSTabsScreenViewController *)controller
+                                 isSearch:(BOOL)isSearch API_AVAILABLE(ios(18.0))
+{
+  // The tab keeps the controller in `userInfo`; the provider returns it lazily.
+  UIViewController * (^provider)(__kindof UITab *) = ^UIViewController *(__kindof UITab *tab) {
+    return static_cast<UIViewController *>(tab.userInfo);
+  };
+
+  UITab *tab = nil;
+  if (isSearch) {
+    tab = [[UISearchTab alloc] initWithViewControllerProvider:provider];
+  } else {
+    NSString *identifier = controller.getScreenKeyOrNull ?: [NSUUID UUID].UUIDString;
+    tab = [[UITab alloc] initWithTitle:controller.tabBarItem.title ?: @""
+                                 image:controller.tabBarItem.image
+                            identifier:identifier
+                viewControllerProvider:provider];
+  }
+  tab.userInfo = controller;
+  return tab;
+}
+
+- (void)syncTabsWithTabBarItems
+{
+  if (!_usesTabsAPI) {
+    return;
+  }
+  if (@available(iOS 18.0, *)) {
+    for (UITab *tab in self.tabs) {
+      auto *controller = static_cast<RNSTabsScreenViewController *>(tab.userInfo);
+      UITabBarItem *item = controller.tabBarItem;
+      if (controller == nil || item == nil) {
+        continue;
+      }
+
+      // A search tab keeps its system-localized title and magnifier image unless overridden.
+      BOOL isSearch = [tab isKindOfClass:UISearchTab.class];
+      RNSTabsScreenComponentView *screenView = controller.tabScreenComponentView;
+      BOOL hasCustomIcon = screenView.iconResourceName != nil || screenView.iconImageSource != nil;
+
+      if (item.title != nil && ![tab.title isEqualToString:item.title]) {
+        tab.title = item.title;
+      }
+      if ((!isSearch || hasCustomIcon) && tab.image != item.image) {
+        tab.image = item.image;
+      }
+#if __IPHONE_OS_VERSION_MAX_ALLOWED >= 270000
+      if (@available(iOS 26.1, *)) {
+        if ((!isSearch || hasCustomIcon) && tab.selectedImage != item.selectedImage) {
+          tab.selectedImage = item.selectedImage;
+        }
+      }
+#endif // __IPHONE_OS_VERSION_MAX_ALLOWED >= 270000
+      if (tab.badgeValue != item.badgeValue && ![tab.badgeValue isEqualToString:item.badgeValue]) {
+        tab.badgeValue = item.badgeValue;
+      }
+      tab.accessibilityIdentifier = item.accessibilityIdentifier;
+    }
+  }
+}
+
+- (nullable UIViewController *)viewControllerForTab:(nullable UITab *)tab API_AVAILABLE(ios(18.0))
+{
+  id controller = tab.userInfo;
+  return [controller isKindOfClass:RNSTabsScreenViewController.class] ? controller : nil;
+}
+
+/// Tab screen controllers in display order, for both the `UITab` API and the view controllers API.
+- (nullable NSArray<UIViewController *> *)managedViewControllers
+{
+  return _usesTabsAPI ? _tabScreenControllers : self.viewControllers;
+}
+
+/// The selected tab screen controller (or the More navigation controller in the view controllers API).
+- (nullable UIViewController *)currentSelectedViewController
+{
+  if (_usesTabsAPI) {
+    if (@available(iOS 18.0, *)) {
+      return [self viewControllerForTab:self.selectedTab];
+    }
+  }
+  return self.selectedViewController;
+}
+
+- (void)selectViewControllerNatively:(nonnull UIViewController *)viewController
+{
+  if (_usesTabsAPI) {
+    if (@available(iOS 18.0, *)) {
+      for (UITab *tab in self.tabs) {
+        if (tab.userInfo == viewController) {
+          self.selectedTab = tab;
+          return;
+        }
+      }
+      RCTLogWarn(@"[RNScreens] Failed to find UITab for view controller: %@", viewController);
+      return;
+    }
+  }
+  [self setSelectedViewController:viewController];
+}
