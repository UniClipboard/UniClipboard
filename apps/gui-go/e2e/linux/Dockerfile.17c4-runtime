# A Linux "host" WITHOUT GTK3, WebKitGTK or the other GUI toolkit libraries the AppImage is supposed to bundle (slice 17c4,
# docs/architecture/gui-go-linux-appimage.md). It has what the AppImage convention leaves to the host: the X server (Xvfb),
# the GPU driver stack (Mesa/libglvnd, libX11, libwayland-client: linuxdeploy's exclude list, docs/architecture/linux-appimage-library-policy.md),
# the other libraries linuxdeploy's exclude list leaves to the host (the sonames the bundled binaries need but the AppDir lacks, listed in
# the 17c4 artifacts as host-provided-sonames.txt; libharfbuzz also brings the host's own GLib, as on every desktop), a D-Bus session, fonts, and FUSE for the real AppImage mount. There is NO Secret Service: gnome-keyring pulls GTK3/GTK4 and
# GLib into the host, which would void the clean-host premise (the non-portable data root is handled separately, see the doc).
# BASE_IMAGE / FUSE_PACKAGE select the host distribution (CI runs the same AppImage on the glibc floor distribution and on a newer one).
ARG BASE_IMAGE=ubuntu:24.04
FROM ${BASE_IMAGE}
ARG FUSE_PACKAGE=libfuse2t64
ENV DEBIAN_FRONTEND=noninteractive
COPY apt_install.sh verify_image_17c4_runtime.sh /usr/local/bin/
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates && rm -rf /var/lib/apt/lists/*
RUN apt_install.sh xvfb xauth dbus dbus-x11 xdotool x11-utils python3 libgl1 libegl1 libgl1-mesa-dri libx11-6 libwayland-client0 \
      fonts-dejavu-core ${FUSE_PACKAGE} fuse3 procps file \
      libexpat1 libfontconfig1 libfreetype6 libfribidi0 libgbm1 libgmp10 libgpg-error0 libharfbuzz0b libxcb1 libx11-xcb1 zlib1g libcom-err2 libstdc++6 libdrm2 libgles2
RUN verify_image_17c4_runtime.sh
