#!/bin/sh
# AppRun of the Go GUI AppImage (docs/architecture/gui-go-linux-appimage.md).
#   * linuxdeploy installs this file as AppRun.wrapped behind its own generated AppRun, which first sources the plugin hook
#     (the GTK plugin exports the GTK, GDK-pixbuf and GSettings paths; since 17c13 package_linux.py removes its unconditional GDK_BACKEND=x11 line, so GTK picks
#     Wayland or X11 itself and a GDK_BACKEND set by the user is honoured);
#   * points GIO_MODULE_DIR at the bundled module directory, which holds exactly the TLS backend (libgiognutls.so from the build image's
#     glib-networking, packaging step `deploy_gio_modules`; the pinned Wails GTK plugin deploys none, and without it libsoup/WebKitGTK
#     have no HTTPS): GIO_EXTRA_MODULES would only append, so the bundled GLib would still scan the host's module directory and
#     load gvfs/dconf modules built for another GLib
#     (docs/architecture/linux-appimage-library-policy.md, "GIO module ABI mixing"; docs/architecture/gui-go-linux-appimage-runtime-deps.md);
#   * runs from $APPDIR/usr: libwebkit2gtk's compiled-in helper directory `/usr/lib/<triple>/webkit2gtk-4.1` was rewritten to
#     `././/lib/<triple>/webkit2gtk-4.1` at packaging time, a path that only resolves relative to $APPDIR/usr.
# The GUI consumes no file or URL argument (its only argument is the quick-panel launch flag), so changing the working
# directory loses nothing.
HERE="$(dirname "$(readlink -f "$0")")"
export APPDIR="${APPDIR:-$HERE}"
# Without a session bus, libdbus/GDBus/godbus start one on demand by running `dbus-launch --autolaunch` as a child of the process that first needs it, and
# that bus hands its environment to every service it activates. From inside the AppImage that environment carries LD_LIBRARY_PATH, so the host's own
# glib-pacrunner would load the bundled (possibly older) GLib and die with "undefined symbol" before it can serve PAC. Start (or find) that same
# autolaunched bus here, before the library path is exported; DBUS_SESSION_BUS_ADDRESS then makes every client use it. Hosts with a session bus
# (the normal desktop case) and sessions without X are untouched.
if [ -z "${DBUS_SESSION_BUS_ADDRESS:-}" ] && [ ! -S "${XDG_RUNTIME_DIR:-/nonexistent}/bus" ] && [ -n "${DISPLAY:-}" ] && command -v dbus-launch >/dev/null 2>&1; then
  machine_id="$(cat /var/lib/dbus/machine-id /etc/machine-id 2>/dev/null | head -n 1)"
  if [ -n "$machine_id" ]; then
    bus_env="$(dbus-launch --autolaunch="$machine_id" --sh-syntax --close-stderr 2>/dev/null)" && eval "$bus_env"
  fi
fi
export LD_LIBRARY_PATH="$APPDIR/usr/lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
for dir in "$APPDIR"/usr/lib/gio/modules "$APPDIR"/usr/lib/*/gio/modules; do
  if [ -d "$dir" ]; then GIO_MODULE_DIR="$dir"; export GIO_MODULE_DIR; break; fi
done
# libproxy 0.4 (Debian 12 builds) finds its PAC runtime plugin through this directory; libproxy 0.5 ignores it. Only set when the package carries the plugin.
if [ -d "$APPDIR/usr/lib/libproxy/modules" ]; then PX_MODULE_PATH="$APPDIR/usr/lib/libproxy/modules"; export PX_MODULE_PATH; fi
cd "$APPDIR/usr" || exit 1
exec "$APPDIR/usr/bin/uniclipboard" "$@"
