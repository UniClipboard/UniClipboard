{
  "name": "docs-site",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build": "next build",
    "cf:next-build": "cross-env NEXT_PUBLIC_SITE_URL=https://docs.uniclipboard.app next build --webpack",
    "cf:build": "cross-env NEXT_PUBLIC_SITE_URL=https://docs.uniclipboard.app opennextjs-cloudflare build",
    "cf:preview": "bun run cf:build && opennextjs-cloudflare preview",
    "cf:deploy": "bun run cf:build && opennextjs-cloudflare deploy",
    "cf:typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "dev": "next dev",
    "start": "next start",
    "types:check": "fumadocs-mdx && next typegen && tsc --noEmit",
    "check:docs": "node scripts/check-docs.mjs",
    "test:config": "node --test test/next-config.test.mjs",
    "postinstall": "fumadocs-mdx",
    "lint": "eslint"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.97",
    "@ai-sdk/openai": "^4.0.109",
    "@ai-sdk/react": "^4.0.167",
    "@orama/tokenizers": "^3.1.18",
    "@radix-ui/react-presence": "^1.1.11",
    "ai": "^7.0.163",
    "fumadocs-core": "16.18.0",
    "fumadocs-mdx": "15.5.0",
    "fumadocs-openapi": "^12.6.0",
    "fumadocs-ui": "16.18.0",
    "lucide-react": "^1.70.0",
    "mermaid": "^12.3.0",
    "next": "16.4.5",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "shiki": "^4.6.0",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "1.20.16",
    "@tailwindcss/postcss": "^4.3.4",
    "@types/mdx": "^2.0.14",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "cross-env": "^10.1.0",
    "eslint": "^10.14.0",
    "eslint-config-next": "16.4.5",
    "github-slugger": "2.0.0",
    "postcss": "^8.5.32",
    "tailwindcss": "^4.3.4",
    "typescript": "^7.0.2",
    "wrangler": "^4.158.0"
  },
  "overrides": {
    "dompurify": "3.4.16",
    "js-yaml": "4.3.2",
    "nanoid": "3.3.18",
    "baseline-browser-mapping": "2.11.21",
    "sharp": "0.35.5",
    "katex": "0.18.2",
    "source-map-js": "1.2.2"
  }
}
