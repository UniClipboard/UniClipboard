+// MeowBootLen is the length of the boot ID that follows the disco key in a ping.
+const MeowBootLen = 16
+
+// EncodeMeowPingBoot is EncodeMeowPing plus a boot ID. A client picks the ID once per
+// engine start and repeats it in every resend, so the server can tell a resend from a
+// restart. Older servers ignore the trailing bytes.
+func EncodeMeowPingBoot(nodeKey key.NodePublic, discoKey key.DiscoPublic, boot [MeowBootLen]byte) []byte {
+	return append(EncodeMeowPing(nodeKey, discoKey), boot[:]...)
+}
+
+// ParseMeowBoot returns the boot ID of a ping that carries one.
+func ParseMeowBoot(pkt []byte) (boot [MeowBootLen]byte, ok bool) {
+	const base = 4 + 1 + key.NodePublicRawLen + key.DiscoPublicRawLen
+	if len(pkt) < base+MeowBootLen {
+		return boot, false
+	}
+	copy(boot[:], pkt[base:base+MeowBootLen])
+	return boot, true
+}
+
