+// resetStalePathLocked drops magicsock's path state for client src when it holds a
+// direct path, so a restarted client is reached through DERP until a new direct path
+// is found. b.mu must be held.
+func (b *locoBackend) resetStalePathLocked(src key.NodePublic) {
+	if b.nm == nil {
+		return
+	}
+	mc := b.sys.MagicSock.Get()
+	sb := ipnstate.StatusBuilder{WantPeers: true}
+	mc.UpdateStatus(&sb)
+	if ps := sb.Status().Peer[src]; ps == nil || ps.CurAddr == "" {
+		return
+	}
+	rest := make([]tailcfg.NodeView, 0, len(b.nm.Peers))
+	for _, p := range b.nm.Peers {
+		if p.Key() != src {
+			rest = append(rest, p)
+		}
+	}
+	mc.SetNetworkMap(b.nm.SelfNode, rest)
+	mc.SetNetworkMap(b.nm.SelfNode, b.nm.Peers)
+	go b.advertiseEndpoints()
+}
