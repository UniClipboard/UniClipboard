# 用例: 主窗口系统边框配置保存和重启
# 目的: 验证默认关闭、保存即持久化以及需要重开窗口。
# 流程: 启动服务，开启配置，重启服务，再关闭配置。
# 期望: 布尔值持久化，服务不报告窗口的待重启状态。
# 不应: 丢失其他配置，或在重启后保留旧状态。

node-start alpha
u alpha config --json
stdout '"system_window_frame": ?false'
u alpha config set desktop.system_window_frame true
u alpha config --json
stdout '"system_window_frame": ?true'
! stdout '"desktop.system_window_frame"'
node-stop alpha
node-start alpha
u alpha config --json
stdout '"system_window_frame": ?true'
! stdout '"desktop.system_window_frame"'
u alpha config set desktop.system_window_frame false
u alpha config --json
stdout '"system_window_frame": ?false'

-- alpha/config.toml --
device_name = "alpha"
