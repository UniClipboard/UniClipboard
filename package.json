{
  "name": "uniclipboard",
  "private": true,
  "version": "1.0.0-alpha.7",
  "license": "AGPL-3.0-only",
  "type": "module",
  "overrides": {
    "@wdio/native-utils": "2.5.0"
  },
  "scripts": {
    "dev": "cross-env UNICLIPBOARD_ENV=development vite",
    "dev:sweep": "node -e \"try{require('child_process').execSync('cargo sweep --time 3 --target target',{stdio:'ignore'})}catch{}\"",
    "dev:sweep-port": "node scripts/sweep-dev-port.mjs",
    "build": "tsc && vite build && node scripts/check-macos-compat.mjs",
    "build:e2e": "cross-env VITE_E2E=1 bun run build",
    "preview": "vite preview",
    "version:bump": "node scripts/bump-version.js",
    "add:beui": "node scripts/add-beui.mjs",
    "gen:openapi": "cargo run -p uc-webserver --bin gen-openapi",
    "gen:client": "openapi-ts",
    "gen:api": "bun run gen:openapi && bun run gen:client",
    "tauri": "tauri",
    "daemon:dev": "node scripts/prepare-daemon-sidecar.mjs --debug",
    "daemon:sidecar": "node scripts/prepare-daemon-sidecar.mjs",
    "tauri:dev": "cross-env UNICLIPBOARD_ENV=development UC_PROFILE=dev tauri dev",
    "tauri:dev:profile": "node scripts/tauri-dev-profile.mjs",
    "tauri:build": "bun run daemon:sidecar && tauri build",
    "tauri:build:dev": "bun run daemon:sidecar && tauri build --config src-tauri/tauri.dev.conf.json --features dev-profile",
    "tauri:dev:peerA": "cross-env UNICLIPBOARD_ENV=development UC_PROFILE=a UC_CLIPBOARD_MODE=full tauri dev",
    "tauri:dev:peerB": "cross-env UNICLIPBOARD_ENV=development UC_PROFILE=b UC_CLIPBOARD_MODE=passive tauri dev --config '{\"build\":{\"beforeDevCommand\":\"\"}}' --no-dev-server-wait",
    "tauri:dev:dual": "bun run daemon:dev && concurrently -k -n peerA,peerB \"bun run tauri:dev:peerA\" \"bun run tauri:dev:peerB\"",
    "tauri:dev:dual:kill": "echo 'Use Ctrl+C in tauri:dev:dual session to stop both peers.'",
    "test": "vitest",
    "test:coverage:frontend": "vitest run --coverage",
    "lint": "oxlint .",
    "lint:fix": "oxlint . --fix",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "prepare": "husky",
    "test:coverage": "cargo llvm-cov --html --workspace",
    "check:engine-repository": "node scripts/architecture/check-engine-repository.mjs",
    "check:cargo-audit-exceptions": "node scripts/architecture/check-cargo-audit-exceptions.mjs",
    "e2e:wdio": "node e2e/run.mjs",
    "e2e:wdio:dual": "node e2e/run.mjs --dual-peer",
    "e2e:card": "scripts/e2e/run-card.sh",
    "doctor": "npx react-doctor@latest"
  },
  "lint-staged": {
    "Cargo.toml": [
      "node scripts/refresh-agents-structure.mjs"
    ],
    "*.{js,jsx,ts,tsx}": [
      "oxlint --fix",
      "oxfmt --write --no-error-on-unmatched-pattern"
    ],
    "*.md": [
      "node scripts/fix-md-cjk-emphasis.mjs",
      "autocorrect --fix"
    ],
    "*.{json,css,html}": [
      "oxfmt --write --no-error-on-unmatched-pattern"
    ],
    "{apps,crates,src-tauri}/**/*.rs": [
      "rustfmt --edition 2021"
    ]
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/noto-sans-sc": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@base-ui/react": "^1.7.0",
    "@base-ui/utils": "^0.3.2",
    "@reduxjs/toolkit": "^2.12.0",
    "@sentry/react": "^10.70.0",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-log": "2.9.0",
    "@tauri-apps/plugin-notification": "^2.3.3",
    "@tauri-apps/plugin-opener": "^2.5.4",
    "@types/culori": "^4.0.1",
    "cuelume": "^0.2.2",
    "culori": "^4.0.2",
    "framer-motion": "^13.1.1",
    "i18next": "^26.4.0",
    "input-otp": "^1.5.0",
    "lucide-react": "^1.33.0",
    "next-themes": "^0.4.6",
    "pino": "^10.3.1",
    "qrcode.react": "^4.2.0",
    "react": "^19.2.8",
    "react-colorful": "^5.8.0",
    "react-dom": "^19.2.8",
    "react-hotkeys-hook": "^5.3.3",
    "react-i18next": "^17.0.12",
    "react-markdown": "^10.1.0",
    "react-masonry-css": "^1.0.16",
    "react-redux": "^9.3.0",
    "react-resizable-panels": "^4.12.3",
    "react-router": "^8.3.0",
    "react-virtuoso": "^4.18.12",
    "semver": "^7.8.5",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@hey-api/openapi-ts": "0.99.0",
    "@react-grab/mcp": "^0.1.37",
    "@sentry/vite-plugin": "^5.4.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2.11.4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.5",
    "@types/mocha": "^10.0.10",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/semver": "^7.8.0",
    "@vitejs/plugin-react": "^6.1.0",
    "@vitest/coverage-v8": "4.1.11",
    "@wdio/cli": "^9.31.2",
    "@wdio/globals": "^9.31.1",
    "@wdio/local-runner": "^9.31.2",
    "@wdio/mocha-framework": "^9.31.2",
    "@wdio/spec-reporter": "^9.31.2",
    "@wdio/tauri-plugin": "^1.3.0",
    "@wdio/tauri-service": "^1.3.0",
    "autocorrect-node": "^2.14.0",
    "autoprefixer": "^10.5.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "concurrently": "^10.0.5",
    "cross-env": "^10.1.0",
    "glob": "^13.0.6",
    "husky": "^9.1.7",
    "jsdom": "^30.0.1",
    "lint-staged": "^17.3.0",
    "mocha": "^11.8.0",
    "oxfmt": "0.64.0",
    "oxlint": "1.79.0",
    "postcss": "^8.5.26",
    "react-grab": "^0.2.0",
    "shadcn": "^4.18.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "~7.0.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.11",
    "webdriverio": "^9.31.2"
  }
}
