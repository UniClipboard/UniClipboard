{
  "name": "uniclipboard",
  "private": true,
  "version": "1.6.2-alpha.1",
  "license": "AGPL-3.0-only",
  "type": "module",
  "scripts": {
    "version:bump": "node scripts/bump-version.js",
    "add:beui": "bun run --cwd apps/gui-go/frontend add:beui",
    "gen:openapi": "cargo run -p uc-webserver --bin gen-openapi",
    "gen:client": "bun run --cwd apps/gui-go/frontend gen:client",
    "gen:api": "bun run gen:openapi && bun run gen:client",
    "gen:host-contract": "node scripts/gen-host-bindings.mjs",
    "gen:theme-presets": "bun apps/quick-panel/export-theme.ts",
    "check:theme-presets": "bun apps/quick-panel/export-theme.ts --check",
    "check:host-contract": "node scripts/gen-host-bindings.mjs --check",
    "check:host-boundary": "bun run typecheck && bun run check:host-structure",
    "mbx:exec": "bash scripts/build-cache/mbx.sh --exec",
    "wails:dev": "node scripts/wails-dev.mjs --profile dev",
    "quickpanel:dev": "node scripts/quickpanel-dev.mjs",
    "quickpanel:dev:profile": "node scripts/quickpanel-dev.mjs --profile",
    "wails:build": "node scripts/wails-build.mjs",
    "wails:dev:profile": "node scripts/wails-dev.mjs --profile",
    "test": "bun run --cwd apps/gui-go/frontend test",
    "test:coverage:frontend": "bun run --cwd apps/gui-go/frontend test:coverage:frontend",
    "typecheck": "bun run --cwd apps/gui-go/frontend typecheck",
    "lint": "oxlint .",
    "lint:fix": "oxlint . --fix",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "prepare": "husky",
    "test:coverage": "cargo llvm-cov --html --workspace",
    "check:engine-repository": "node scripts/architecture/check-engine-repository.mjs",
    "check:tauri-retired": "node scripts/architecture/check-tauri-retired.mjs",
    "check:cargo-audit-exceptions": "node scripts/architecture/check-cargo-audit-exceptions.mjs",
    "check:ui-kit-bundles": "node apps/gui-go/frontend/e2e/ui-kit-bundle-check.mjs",
    "doctor": "bun run --cwd apps/gui-go/frontend doctor",
    "check:host-structure": "node scripts/architecture/check-host-events.mjs && cd apps/gui-go && go run ./cmd/hostcontract lint && go run ./cmd/hostcontract e2e-table -check && go run ./cmd/hostcontract docs -check",
    "e2e:gui": "node scripts/gui-e2e.mjs",
    "preview:ui-kit": "node apps/gui-go/frontend/e2e/ui-kit-preview.mjs"
  },
  "lint-staged": {
    "Cargo.toml": [
      "node scripts/refresh-agents-structure.mjs"
    ],
    "*.{js,jsx,ts,tsx}": [
      "oxlint --fix --no-error-on-unmatched-pattern",
      "oxfmt --write --no-error-on-unmatched-pattern"
    ],
    "*.md": [
      "node scripts/fix-md-cjk-emphasis.mjs",
      "autocorrect --fix"
    ],
    "*.{json,css,html}": [
      "oxfmt --write --no-error-on-unmatched-pattern"
    ],
    "{apps,crates}/**/*.rs": [
      "rustfmt --edition 2021"
    ]
  },
  "devDependencies": {
    "@e2e-dev/web": "0.15.5",
    "@hey-api/openapi-ts": "0.99.0",
    "@react-grab/mcp": "^0.1.37",
    "@sentry/vite-plugin": "^11.11.0",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/semver": "^7.8.0",
    "@vitejs/plugin-react": "^6.2.1",
    "@vitest/coverage-v8": "5.1.0",
    "autocorrect-node": "^2.14.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cross-env": "^10.1.0",
    "e2e": "0.23.0",
    "glob": "^14.0.4",
    "husky": "^9.1.7",
    "jsdom": "^31.0.0",
    "lint-staged": "^17.6.0",
    "oxfmt": "0.76.0",
    "oxlint": "1.91.0",
    "picomatch": "^4.0.7",
    "postcss": "^8.5.32",
    "react-grab": "^0.2.0",
    "semver": "^7.8.6",
    "shadcn": "^4.23.0",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.4",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "~7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.0",
    "webdriverio": "^10.2.0",
    "yaml": "^2.9.1"
  },
  "workspaces": [
    "apps/gui-go/frontend"
  ]
}
