{
  "name": "uniclipboard",
  "private": true,
  "version": "1.1.1",
  "license": "AGPL-3.0-only",
  "type": "module",
  "overrides": {
    "@wdio/native-utils": "2.5.0"
  },
  "scripts": {
    "dev": "bun run --cwd apps/gui dev",
    "dev:sweep": "node -e \"try{require('child_process').execSync('cargo sweep --time 3 --target target',{stdio:'ignore'})}catch{}\"",
    "dev:sweep-port": "node scripts/sweep-dev-port.mjs",
    "build": "bun run --cwd apps/gui build",
    "build:e2e": "bun run --cwd apps/gui build:e2e",
    "preview": "bun run --cwd apps/gui preview",
    "version:bump": "node scripts/bump-version.js",
    "add:beui": "bun run --cwd apps/gui add:beui",
    "gen:openapi": "cargo run -p uc-webserver --bin gen-openapi",
    "gen:client": "bun run --cwd apps/gui gen:client",
    "gen:api": "bun run gen:openapi && bun run gen:client",
    "tauri": "bun run --cwd apps/gui tauri",
    "daemon:dev": "node scripts/prepare-sidecars.mjs --debug",
    "daemon:sidecar": "node scripts/prepare-sidecars.mjs",
    "mbx:exec": "bash scripts/build-cache/mbx.sh --exec",
    "tauri:dev": "cross-env UNICLIPBOARD_ENV=development UC_PROFILE=dev bun run tauri dev",
    "tauri:dev:profile": "node scripts/tauri-dev-profile.mjs",
    "tauri:build": "bun run daemon:sidecar && bun run tauri build",
    "tauri:build:dev": "bun run daemon:sidecar && bun run tauri build --config src-tauri/tauri.dev.conf.json --features dev-profile",
    "tauri:dev:peerA": "cross-env UNICLIPBOARD_ENV=development UC_PROFILE=a UC_CLIPBOARD_MODE=full bun run tauri dev",
    "tauri:dev:peerB": "cross-env UNICLIPBOARD_ENV=development UC_PROFILE=b UC_CLIPBOARD_MODE=passive bun run tauri dev --config '{\"build\":{\"beforeDevCommand\":\"\"}}' --no-dev-server-wait",
    "tauri:dev:dual": "bun run daemon:dev && concurrently -k -n peerA,peerB \"bun run tauri:dev:peerA\" \"bun run tauri:dev:peerB\"",
    "tauri:dev:dual:kill": "echo 'Use Ctrl+C in tauri:dev:dual session to stop both peers.'",
    "test": "bun run --cwd apps/gui test",
    "test:coverage:frontend": "bun run --cwd apps/gui test:coverage:frontend",
    "lint": "oxlint .",
    "lint:fix": "oxlint . --fix",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "prepare": "husky",
    "test:coverage": "cargo llvm-cov --html --workspace",
    "check:engine-repository": "node scripts/architecture/check-engine-repository.mjs",
    "check:cargo-audit-exceptions": "node scripts/architecture/check-cargo-audit-exceptions.mjs",
    "e2e:wdio": "node apps/gui/e2e/run.mjs",
    "e2e:custom-relays": "node apps/gui/e2e/custom-relays.e2e.mjs",
    "e2e:relay-overview": "node apps/gui/e2e/relay-overview.e2e.mjs",
    "e2e:wdio:dual": "node apps/gui/e2e/run.mjs --dual-peer",
    "e2e:wdio:triple": "node apps/gui/e2e/run.mjs --triple-peer",
    "e2e:conflicts": "npx --yes --package=node@24 node apps/gui/e2e/conflict-suite.mjs",
    "e2e:conflicts:all": "npx --yes --package=node@24 node apps/gui/e2e/conflict-all.mjs",
    "e2e:card": "scripts/e2e/run-card.sh",
    "doctor": "bun run --cwd apps/gui doctor"
  },
  "lint-staged": {
    "Cargo.toml": [
      "node scripts/refresh-agents-structure.mjs"
    ],
    "*.{js,jsx,ts,tsx}": [
      "oxlint --fix",
      "oxfmt --write --no-error-on-unmatched-pattern"
    ],
    "*.md": [
      "node scripts/fix-md-cjk-emphasis.mjs",
      "autocorrect --fix"
    ],
    "*.{json,css,html}": [
      "oxfmt --write --no-error-on-unmatched-pattern"
    ],
    "{apps,crates}/**/*.rs": [
      "rustfmt --edition 2021"
    ]
  },
  "devDependencies": {
    "@hey-api/openapi-ts": "0.97.3",
    "@react-grab/mcp": "^0.1.37",
    "@sentry/vite-plugin": "^5.3.0",
    "@tailwindcss/typography": "^0.5.19",
    "@tailwindcss/vite": "^4.3.0",
    "@tauri-apps/cli": "^2.11.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/mocha": "^10.0.10",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/semver": "^7.7.0",
    "@vitejs/plugin-react": "^6.0.2",
    "@vitest/coverage-v8": "4.1.6",
    "@wdio/cli": "^9.27.1",
    "@wdio/globals": "^9.27.1",
    "@wdio/local-runner": "^9.27.1",
    "@wdio/mocha-framework": "^9.27.1",
    "@wdio/spec-reporter": "^9.27.1",
    "@wdio/tauri-plugin": "^1.2.0",
    "@wdio/tauri-service": "^1.2.0",
    "autocorrect-node": "^2.14.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "glob": "^13.0.6",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "lint-staged": "^17.0.4",
    "mocha": "^10.8.2",
    "oxfmt": "0.63.0",
    "oxlint": "1.78.0",
    "postcss": "^8.5.14",
    "react-grab": "^0.1.50",
    "shadcn": "^4.7.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.0",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "~6.0.3",
    "vite": "^8.0.13",
    "vitest": "^4.1.6",
    "webdriverio": "^9.27.1"
  },
  "workspaces": [
    "apps/gui",
    "apps/gui-go"
  ]
}
