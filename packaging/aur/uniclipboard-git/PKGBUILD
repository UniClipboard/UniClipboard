# Maintainer: UniClipboard <aur@uniclipboard.app>
#
# Source package that tracks main: it clones the repository and builds the Go/Wails desktop host
# (apps/gui-go) plus the Rust daemon (uniclipd). It conflicts with the `uniclipboard-bin` package that
# repackages the .deb.
#
# Sync rules: this file is the source of truth. .github/workflows/aur.yml builds it in a clean Arch
# container on every change (pull request and main) and pushes it to the AUR only from a manual dispatch
# with `publish` set. Do not edit the AUR copy by hand; it is overwritten by the next publish.

pkgname=uniclipboard-git
_pkgname=uniclipboard
# Snapshot shown on the AUR web page; makepkg recomputes it with pkgver() below. The publish step
# replaces this line with the current `git describe` value.
pkgver=0.10.1.alpha.2.r0.g0000000
pkgrel=1
pkgdesc="Real-time clipboard sync across macOS, Windows and Linux — local-first, peer-to-peer, and end-to-end encrypted"
arch=('x86_64' 'aarch64')
url="https://www.uniclipboard.app"
license=('AGPL-3.0-only')
# The GUI links GTK 3, WebKitGTK 4.1 (with libsoup 3 and JavaScriptCore) and Xlib; gtk-layer-shell is
# loaded at run time for the quick panel on Wayland. The tray and notifications use D-Bus directly, so
# no appindicator or libnotify is needed.
depends=('gtk3' 'webkit2gtk-4.1' 'gtk-layer-shell' 'libx11' 'libsoup3')
# `bun` builds the shared frontend (extra/bun). `jq` reads the app identity from apps/gui-go/app.json, the
# single source of it. The `go` in extra satisfies the toolchain line of apps/gui-go/go.mod, so no
# toolchain is downloaded during the build.
makedepends=('git' 'rust' 'go' 'bun' 'jq' 'pkgconf')
provides=("$_pkgname" "$_pkgname=$pkgver")
# Packages share one executable path, so they cannot be installed together.
conflicts=("$_pkgname" "${_pkgname}-bin")
source=("$_pkgname::git+https://github.com/UniClipboard/UniClipboard.git")
sha256sums=('SKIP')
# The Rust release profile already uses thin LTO; makepkg's global LTO flags would only fight it, and
# Go and Cargo do not use CFLAGS for their own code. Both executables are stripped at link time, so there is
# nothing for a separate -debug package to split off.
options=('!lto' '!debug')

pkgver() {
  cd "$_pkgname"
  # v0.10.1-alpha.2-3-g1234567 -> 0.10.1.alpha.2.r3.g1234567
  # 1) sed 's/^v//'             drop the v prefix
  # 2) 's/\([^-]*-g\)/r\1/'     put an r before the trailing "<count>-g<hash>"
  # 3) 's/-/./g'                every - becomes . to satisfy the pacman version format
  ( git describe --long --tags --abbrev=7 2>/dev/null \
      | sed 's/^v//; s/\([^-]*-g\)/r\1/; s/-/./g' ) \
    || printf "0.0.0.r%s.g%s" \
         "$(git rev-list --count HEAD)" \
         "$(git rev-parse --short=7 HEAD)"
}

prepare() {
  cd "$_pkgname"
  export CARGO_HOME="$srcdir/cargo-home" GOPATH="$srcdir/gopath"
  # --frozen-lockfile fails when the lockfile and package.json disagree, so a main commit with
  # inconsistent dependencies is caught here instead of silently upgrading.
  bun install --frozen-lockfile
  # Fetch every module now so build() needs no network. The dependency set is the locked one
  # (Cargo.lock, go.sum); -modcacherw keeps the module cache removable by makepkg.
  cargo fetch --locked --target "$(rustc -vV | sed -n 's/^host: //p')"
  (cd apps/gui-go && go mod download -modcacherw)
}

build() {
  cd "$_pkgname"
  export CARGO_HOME="$srcdir/cargo-home" GOPATH="$srcdir/gopath"
  export CGO_ENABLED=1 CARGO_TARGET_DIR="$PWD/target"

  # The daemon the GUI starts as its sibling ($pkgdir/usr/bin/uniclipd).
  cargo build --frozen --release -p uc-daemon --bin uniclipd

  # The shipped frontend bundle is embedded into the GUI executable.
  (cd packages/desktop-host-go && go generate ./buildinfo)
  bun --bun run --cwd apps/gui-go/frontend build

  # Product name, identifier and updater key come from app.json. The identifier keys the
  # single-instance scope, login item and notifications, so it must match the other packages. The
  # update key is baked in like in every build, but a package-manager install never replaces itself.
  local root="$PWD" product identifier pubkey
  product="$(jq -r .productName apps/gui-go/app.json)"
  identifier="$(jq -r .identifier apps/gui-go/app.json)"
  pubkey="$(jq -r .updater.pubkey apps/gui-go/app.json)"
  (cd apps/gui-go && go build -tags gtk3,production,release \
      -trimpath -buildvcs=false -mod=readonly -modcacherw \
      -ldflags "-w -s -X main.updaterPublicKey=$pubkey -X main.productName=$product -X main.bundleID=$identifier" \
      -o "$root/target/release/$_pkgname" .)
}

package() {
  cd "$_pkgname"

  install -Dm755 "target/release/$_pkgname" "$pkgdir/usr/bin/$_pkgname"
  install -Dm755 "target/release/uniclipd"  "$pkgdir/usr/bin/uniclipd"

  install -Dm644 "packaging/linux/$_pkgname.desktop" \
                 "$pkgdir/usr/share/applications/$_pkgname.desktop"

  # hicolor icons, renamed from the size-named sources. The @2x file is 256x256 pixels: Linux
  # selects by size, not by Retina scale. Same set as the deb, rpm and AppImage
  # (apps/gui-go/e2e/package_linux.py ICONS).
  install -Dm644 "apps/gui-go/icons/32x32.png"      "$pkgdir/usr/share/icons/hicolor/32x32/apps/$_pkgname.png"
  install -Dm644 "apps/gui-go/icons/128x128.png"    "$pkgdir/usr/share/icons/hicolor/128x128/apps/$_pkgname.png"
  install -Dm644 "apps/gui-go/icons/128x128@2x.png" "$pkgdir/usr/share/icons/hicolor/256x256/apps/$_pkgname.png"

  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
